{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "rh/language-switcher",
	"version": "0.1.0",
	"title": "Sprach-Switcher",
	"category": "design",
	"icon": "translation",
	"description": "Verlinkt pro Sprache auf die passende Übersetzung der aktuellen Seite. Reiner Text-Switch, keine Flaggen.",
	"textdomain": "rh-languages",
	"supports": {
		"html": false,
		"align": ["left", "center", "right"],
		"color": {
			"text": true,
			"background": true,
			"link": true,
			"__experimentalDefaultControls": {
				"text": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontWeight": true,
			"__experimentalLetterSpacing": true,
			"__experimentalTextTransform": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		}
	},
	"editorScript": "rh-language-switcher-editor",
	"style": "rh-language-switcher",
	"render": "file:./render.php"
}
